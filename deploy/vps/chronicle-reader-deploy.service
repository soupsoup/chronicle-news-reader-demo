[Unit]
Description=Deploy the newest chronicle-reader commit if main changed
After=network-online.target

[Service]
Type=oneshot
User=chronicle-reader
Group=chronicle-reader
WorkingDirectory=/var/www/chronicle-reader
EnvironmentFile=-/etc/chronicle-reader.env
Environment=NODE_OPTIONS=--max-old-space-size=1536
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/var/www/chronicle-reader/deploy/vps/deploy.sh
Nice=10
CPUWeight=20
IOSchedulingClass=idle
TimeoutStartSec=20min
